---
import GroupPicker from "@components/GroupPicker.astro";
import FemmeStormWork from "@layouts/FemmeStormWork.astro";
import { fetchCategories, fetchGroups, fetchMediums } from "@lib/contentful";

export async function getStaticPaths() {
  const mediums = await fetchMediums();

  const mediumCategoryGroups = mediums.items.flatMap((medium) =>
    medium.fields.categories
      ? medium.fields.categories.flatMap((category) =>
          category.fields.groups
            ? category.fields.groups.map((group) => ({
                medium: medium,
                category: category,
                group: group,
              }))
            : [],
        )
      : [],
  );

  const pages = mediumCategoryGroups.map((mediumCategoryGroup) => ({
    params: {
      medium: mediumCategoryGroup.medium.fields.name,
      category: mediumCategoryGroup.category.fields.category,
      group: mediumCategoryGroup.group.fields.slug,
    },
  }));

  return pages;
}

const { medium, category, group } = Astro.params;
const mediumCategories = await fetchCategories(medium);
const categoryGroups = await fetchGroups(medium, category);
---

<FemmeStormWork title={group} categories={mediumCategories}>
  <GroupPicker groups={categoryGroups} />
</FemmeStormWork>
