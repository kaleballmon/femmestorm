---
import FemmeStormWork from "@layouts/FemmeStormWork.astro";
import { fetchCategories, fetchMediums } from "@lib/contentful";

export async function getStaticPaths() {
  const mediums = await fetchMediums();

  const mediumCategories = mediums.items.flatMap((medium) =>
    medium.fields.categories
      ? medium.fields.categories.map((category) => ({ medium, category }))
      : [],
  );

  const noGroupMediumCategories = mediumCategories.filter(
    (mediumCateogry) => !mediumCateogry.category.fields.groups,
  );

  const pages = noGroupMediumCategories.map((noGroupMediumCategory) => ({
    params: {
      medium: noGroupMediumCategory.medium.fields.name,
      category: noGroupMediumCategory.category.fields.category,
    },
  }));

  return pages;
}

const { category, medium } = Astro.params;
const mediumCategories = await fetchCategories(medium);
---

<FemmeStormWork title={category} categories={mediumCategories} />
